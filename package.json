{
  "name": "golem-graph",
  "version": "1.0.1",
  "description": "Declarative SVG graphing engine for mathematical equations. Supports explicit and implicit curves, adaptive sampling, and marching squares.",
  "main": "dist/golem.js",
  "module": "src/bundle-entry.js",
  "browser": "dist/golem.min.js",
  "exports": {
    ".": {
      "browser": "./dist/golem.min.js",
      "import": "./src/bundle-entry.js",
      "require": "./dist/golem.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "integrations/remark/",
    "README.md"
  ],
  "scripts": {
    "demo": "npx serve .",
    "test": "node --test test/parser.test.js test/compiler.test.js test/render.test.js test/e2e.test.js",
    "build": "esbuild src/bundle-entry.js --bundle --format=iife --global-name=GolemBundle --outfile=dist/golem.js",
    "build:min": "esbuild src/bundle-entry.js --bundle --format=iife --global-name=GolemBundle --outfile=dist/golem.min.js --minify",
    "prepublishOnly": "npm test && npm run build && npm run build:min"
  },
  "keywords": [
    "math",
    "svg",
    "graphing",
    "visualization",
    "equation",
    "chart",
    "plot"
  ],
  "license": "MIT",
  "peerDependencies": {
    "mathjs": ">=11.0.0"
  },
  "peerDependenciesMeta": {
    "mathjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "mathjs": "^13.2.3"
  }
}
